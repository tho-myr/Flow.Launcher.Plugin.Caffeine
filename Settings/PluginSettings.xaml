<UserControl x:Class="Flow.Launcher.Plugin.Caffeine.Settings.PluginSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid Margin="{StaticResource SettingPanelMargin}" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Caffeine Settings Section -->
        <TextBlock Grid.Row="0" Text="Caffeine Settings" 
                   FontWeight="Bold" 
                   FontSize="14" 
                   Margin="0,10,0,10"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        
        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Top">
            <CheckBox x:Name="StartWithFlowLauncherCheckBox"
                      VerticalAlignment="Center"
                      Margin="0,5,0,5"
                      Checked="StartWithFlowLauncherCheckBox_Changed"
                      Unchecked="StartWithFlowLauncherCheckBox_Changed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" 
                               Text="&#xE7E8;" 
                               FontSize="16" 
                               Margin="0,0,8,0" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="Start caffeine service when Flow Launcher starts" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Orientation="Vertical" VerticalAlignment="Top">
            <CheckBox x:Name="SendNotificationsCheckBox"
                      VerticalAlignment="Center"
                      Margin="0,5,0,5"
                      Checked="SendNotificationsCheckBox_Changed"
                      Unchecked="SendNotificationsCheckBox_Changed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" 
                               Text="&#xE7F3;" 
                               FontSize="16" 
                               Margin="0,0,8,0" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="Send notifications when caffeine starts/stops" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>
        
        <StackPanel Grid.Row="3" Orientation="Vertical" VerticalAlignment="Top">
            <CheckBox x:Name="ShowTrayIconCheckBox"
                      VerticalAlignment="Center"
                      Margin="0,5,0,5"
                      Checked="ShowTrayIconCheckBox_Changed"
                      Unchecked="ShowTrayIconCheckBox_Changed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" 
                               Text="&#xE7C4;" 
                               FontSize="16" 
                               Margin="0,0,8,0" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="Show tray icon when caffeine is active" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>
        
        <!-- Separator -->
        <Separator Grid.Row="4" Margin="0,15,0,10" 
                   Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
        
        <!-- Mouse Mover Settings Section -->
        <TextBlock Grid.Row="5" Text="Mouse Mover Settings" 
                   FontWeight="Bold" 
                   FontSize="14" 
                   Margin="0,5,0,10"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        
        <StackPanel Grid.Row="6" Orientation="Vertical" VerticalAlignment="Top">
            <CheckBox x:Name="StartMouseMoverWithFlowLauncherCheckBox"
                      VerticalAlignment="Center"
                      Margin="0,5,0,5"
                      Checked="StartMouseMoverWithFlowLauncherCheckBox_Changed"
                      Unchecked="StartMouseMoverWithFlowLauncherCheckBox_Changed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" 
                               Text="&#xE7E8;" 
                               FontSize="16" 
                               Margin="0,0,8,0" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="Start mouse mover when Flow Launcher starts" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>
        
        <StackPanel Grid.Row="7" Orientation="Vertical" VerticalAlignment="Top" Margin="0,10,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock FontFamily="Segoe MDL2 Assets" 
                           Text="&#xE916;" 
                           FontSize="16" 
                           Margin="0,0,8,0" 
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock Text="Delay before mouse mover starts (seconds):" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"/>
                <TextBox x:Name="MouseMoverDelayTextBox"
                         Width="120"
                         Height="25"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         TextChanged="MouseMoverDelayTextBox_TextChanged"/>
            </StackPanel>
            <TextBlock x:Name="MouseMoverDelayErrorText"
                       Text="Please enter a value between 1 and 3600 seconds. Will revert to last valid value."
                       FontSize="11" 
                       Margin="24,2,0,0"
                       Foreground="Red"
                       Visibility="Collapsed"/>
            <TextBlock Text="How long to wait after no user mouse movement before starting automatic movement" 
                       FontSize="11" 
                       Margin="24,0,0,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
